{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "kasir-nusa-pos",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "uji.nusapos.my.id",
      "custom_domain": true
    },
    {
      "pattern": "app.nusapos.my.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./apps/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_APP_URL": "https://app.nusapos.my.id",
    "ALLOW_OWNER_BOOTSTRAP": "false",
    "DEFAULT_BUSINESS_NAME": "Kasir Nusa",
    "CLOUDFLARE_WORKERS_PLAN": "PAID"
  }
}
