{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  null,
    "outputDirectory":  "apps/web",
    "functions":  {
                      "api/index.mjs":  {
                                            "maxDuration":  15
                                        }
                  },
    "rewrites":  [
                     {
                         "source":  "/api/:path*",
                         "destination":  "/api/index?route=:path*"
                     },
                     {
                         "source":  "/:path*",
                         "destination":  "/index.html"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(self)"
                                        }
                                    ]
                    },
                    {
                        "source":  "/service-worker.js",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=0, must-revalidate"
                                        }
                            ]
                    },
                    {
                        "source":  "/downloads/Kasir-Nusa-Kasir-1.0.0-test.apk",
                        "headers":  [
                                        {
                                            "key":  "Content-Type",
                                            "value":  "application/vnd.android.package-archive"
                                        },
                                        {
                                            "key":  "Content-Disposition",
                                            "value":  "attachment; filename=Kasir-Nusa-Kasir-1.0.0-test.apk"
                                        },
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=3600"
                                        }
                                    ]
                    },
                    {
                        "source":  "/downloads/Kasir-Nusa-Kasir-1.1.0-test.apk",
                        "headers":  [
                                        {
                                            "key":  "Content-Type",
                                            "value":  "application/vnd.android.package-archive"
                                        },
                                        {
                                            "key":  "Content-Disposition",
                                            "value":  "attachment; filename=Kasir-Nusa-Kasir-1.1.0-test.apk"
                                        },
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=3600"
                                        }
                                    ]
                    },
                    {
                        "source":  "/api/:path*",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store"
                                        }
                                    ]
                    }
                ]
}
