{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  null,
    "outputDirectory":  "apps/web",
    "functions":  {
                      "api/index.mjs":  {
                                            "maxDuration":  15
                                        }
                  },
    "rewrites":  [
                     {
                         "source":  "/api/:path*",
                         "destination":  "/api/index?route=:path*"
                     },
                     {
                         "source":  "/:path*",
                         "destination":  "/index.html"
                     }
                 ],
    "headers":  [
                    {
                        "source":  "/(.*)",
                        "headers":  [
                                        {
                                            "key":  "Permissions-Policy",
                                            "value":  "camera=(self)"
                                        }
                                    ]
                    },
                    {
                        "source":  "/service-worker.js",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "public, max-age=0, must-revalidate"
                                        }
                                    ]
                    },
                    {
                        "source":  "/api/:path*",
                        "headers":  [
                                        {
                                            "key":  "Cache-Control",
                                            "value":  "no-store"
                                        }
                                    ]
                    }
                ]
}
